.envrc
*.zwc
.DS_Store

# Claude - ignore everything, then whitelist what we want
claude/*
!claude/commands/
!claude/skills/
!claude/settings.json
# settings.json points at this by path, so it has to ship alongside it
!claude/statusline-command.sh
!claude/projects/
# Under a project only memory/ is ours; everything else is per-session churn
# (transcripts, workflows, tool-results) that Claude Code keeps inventing more of.
claude/projects/*/*
!claude/projects/*/memory/
claude/projects/-Users-tommasochecchi
claude/projects/-Users-tommasochecchi-Developer-tomatocake-dev
